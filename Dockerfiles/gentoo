# vim: ft=Dockerfile

FROM gentoo/stage3:latest

RUN export FEATURES="-ipc-sandbox -network-sandbox -pid-sandbox -sandbox -usersandbox" && \
        emerge-webrsync && \
        eselect news read --quiet new 1>/dev/null 2>&1 && \
        emerge --verbose --update --deep --with-bdeps=y --backtrack=30 --newuse @world && \
        USE="X harfbuzz" emerge dev-build/meson dev-vcs/git && \
        USE="X harfbuzz wayland pulseaudio" emerge dev-libs/wayland dev-libs/wayland-protocols dev-cpp/gtkmm dev-cpp/glibmm:2 \
        gui-libs/gtk4-layer-shell dev-libs/libnl sys-power/upower media-sound/playerctl media-libs/libpulse dev-libs/libevdev \
        dev-libs/libinput media-libs/libmpdclient dev-libs/iniparser sci-libs/fftw && \
        USE="gtk3" emerge dev-libs/libdbusmenu
