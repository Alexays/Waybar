# wrap-git makes meson run `git clone` during the build, which fails in a sandbox
# without network access ("Automatic wrap-based subproject downloading is disabled").
# Keep the archive form: the Nix packaging prefetches this revision and places it at
# `directory` before configuring (see nix/default.nix, whose pin must match here).
#[wrap-git]
#url = https://github.com/LukashonakV/cava.git
#revision = 8d6e963db9cd29c2b3b5a5df1e46bb65c410f9cc
#depth = 1

[wrap-file]
directory = cava-1.0.0
source_url = https://github.com/LukashonakV/cava/archive/1.0.0.tar.gz
source_filename = cava-1.0.0.tar.gz
source_hash = 437df0a29e52e555357a06238f4c5cbe6d51b5dd4225700cb7adbb19d8bb9474
[provide]
libcava = cava_dep
